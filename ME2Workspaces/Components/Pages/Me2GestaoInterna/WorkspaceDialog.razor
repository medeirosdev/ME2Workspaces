@using MudBlazor
@using ME2Workspaces.ModulosME2.ME2GestaoInterna
@using static ME2Workspaces.ModulosME2.ME2GestaoInterna.ClsGestaoInterna
@inject ISnackbar Snackbar

<MudDialog Style="max-width:600px; width:100%; padding:20px; border-radius:12px;">
    <TitleContent>
        <MudText Typo="Typo.h6">@(Workspace.Id == 0 ? "Novo Workspace" : "Editar Workspace")</MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="form">
            <MudTextField @bind-Value="Workspace.Nome" Label="Nome" Required="true" />
            <MudTextField @bind-Value="Workspace.Descricao" Label="Descrição" Lines="3" />
            <MudDatePicker @bind-Date="Workspace.DataInicio" Label="Data Início" />
            <MudDatePicker @bind-Date="Workspace.DataFim" Label="Data Fim" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="Save" Disabled="!form.IsValid">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Workspace Workspace { get; set; } = new();

    private MudForm form { get; set; } = new();

    private async Task Save()
    {
        await form.Validate();
        if (!form.IsValid) return;

        try
        {
            if (Workspace.Id == 0)
            {
                GestaoInternaServico Servico = new();
                await Servico.CreateWorkspace(Workspace);
                Snackbar.Add("Workspace criado", Severity.Success);
            }
            else
            {
                GestaoInternaServico Servico = new();
                await Servico.UpdateWorkspace(Workspace);
                Snackbar.Add("Workspace atualizado", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
