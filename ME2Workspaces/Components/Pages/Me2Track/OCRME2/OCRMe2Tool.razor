    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public bool novoItem { get; set; } = true;
    [Parameter] public long insightId { get; set; } = 9999;
    [Parameter] public long ID_Influencer { get; set; } = 9999;
    [Parameter] public long IDCampanha { get; set; } = 9999;
    [Parameter] public long ID_Usuario { get; set; } = 9999;

    public string languageEng { get; set; } = "eng";
    public string languagePor { get; set; } = "por";
    public string languageSpa { get; set; } = "spa";

