                    ["ProximoStory"] = new[] { @"siguiente historia[:\s]*(\d+)", @"(\d+)\s*siguiente historia" },
                    ["Voltar"] = new[] { @"(?:atrás|volver)[:\s]*(\d+)", @"(\d+)\s*(?:atrás|volver)" },
                    ["Saiu"] = new[] { @"salidas[:\s]*(\d+)", @"(\d+)\s*salidas" },
                    ["VisitasPerfil"] = new[] { @"visitas al perfil[:\s]*(\d+)", @"(\d+)\s*visitas al perfil" },
                    ["ToquesLinkExterno"] = new[] { @"toques en enlaces externos[:\s]*(\d+)", @"(\d+)\s*toques en enlaces externos" },
                    ["NovosSeguidores"] = new[] { @"(?:nuevos seguidores|comenzaron a seguir)[:\s]*(\d+)", @"(\d+)\s*(?:nuevos seguidores|comenzaron a seguir)" },
                    ["ContasAlcancadas"] = new[] { @"(?:cuentas alcanzadas|alcance)[:\s]*(\d+)", @"(\d+)\s*(?:cuentas alcanzadas|alcance)" },
                    ["ContasComEngajamento"] = new[] { @"(?:cuentas con interacción|cuentas que interactuaron)[:\s]*(\d+)", @"(\d+)\s*(?:cuentas con interacción|cuentas que interactuaram)" }
                }
            };

        string langKey = selectedLanguage.ToLower().EndsWith("eng") ? "eng"
                        : selectedLanguage.ToLower().EndsWith("spa") ? "spa"
                        : "por";

        var currentKvpMappings = kvpKeyMappings[langKey];
        var currentRegexPatterns = regexValuePatterns[langKey];

        if (result.KeyValuePairs != null)
        {
            foreach (var kvp in result.KeyValuePairs)
            {
                var keyText = normalizeTextForParsing(kvp.Key.Content);
                var valueText = kvp.Value.Content;
                if (string.IsNullOrEmpty(keyText) || string.IsNullOrEmpty(valueText)) continue;
                foreach (var map in currentKvpMappings)
                {
                    if (extractedData.ContainsKey(map.Key)) break;
                    foreach (var kw in map.Value)
                    {
                        if (keyText.Contains(kw))
                        {
                            var digits = Regex.Replace(valueText, @"[^\d]", "");
                            if (long.TryParse(digits, out var num))
                            {
                                extractedData[map.Key] = num;
                                goto NextKvp;
                            }
                        }
                    }
                }
            NextKvp:;
            }
        }

        var allText = normalizeTextForParsing(string.Join("\n", result.Pages.SelectMany(p => p.Lines).Select(l => l.Content)));
        foreach (var patEntry in currentRegexPatterns)
        {
            if (extractedData.ContainsKey(patEntry.Key)) continue;
            foreach (var pat in patEntry.Value)
            {
                var m = Regex.Match(allText, pat, RegexOptions.IgnoreCase);
                if (m.Success && m.Groups.Count > 1)
                {
                    var d = Regex.Replace(m.Groups[1].Value, @"[^\d]", "");
                    if (long.TryParse(d, out var n))
                    {
                        extractedData[patEntry.Key] = n;
                        break;
                    }
                }
            }
        }

        if (insight.Visualizacoes == 0 && extractedData.TryGetValue("Visualizacoes", out var vis)) insight.Visualizacoes = vis;
        if (insight.Interacoes == 0 && extractedData.TryGetValue("Interacoes", out var it)) insight.Interacoes = it;
        if (insight.Curtidas == 0 && extractedData.TryGetValue("Curtidas", out var cu)) insight.Curtidas = (int)cu;
        if (insight.Respostas == 0 && extractedData.TryGetValue("Respostas", out var re)) insight.Respostas = (int)re;
        if (insight.Compartilhamentos == 0 && extractedData.TryGetValue("Compartilhamentos", out var cp)) insight.Compartilhamentos = (int)cp;
        if (insight.AlcanceSeguidores == 0 && extractedData.TryGetValue("ToquesFigurinha", out var tf)) insight.AlcanceSeguidores = (int)tf;
        if (insight.ContasAlcancadas == 0 && extractedData.TryGetValue("CliquesLink", out var cl)) insight.ContasAlcancadas = (int)cl;
        if (insight.Avanco == 0 && extractedData.TryGetValue("Avanco", out var av)) insight.Avanco = (int)av;
        if (insight.ContasComEngajamento == 0 && extractedData.TryGetValue("ContasComEngajamento", out var ce)) insight.ContasComEngajamento = (int)ce;
        if (insight.ProximoStory == 0 && extractedData.TryGetValue("ProximoStory", out var ps)) insight.ProximoStory = (int)ps;
        if (insight.Voltar == 0 && extractedData.TryGetValue("Voltar", out var vo)) insight.Voltar = (int)vo;
        if (insight.Saiu == 0 && extractedData.TryGetValue("Saiu", out var sa)) insight.Saiu = (int)sa;
        if (insight.VisitasAoPerfil == 0 && extractedData.TryGetValue("VisitasPerfil", out var vp)) insight.VisitasAoPerfil = (int)vp;
        if (insight.ComecaramASeguir == 0 && extractedData.TryGetValue("NovosSeguidores", out var ns)) insight.ComecaramASeguir = (int)ns;
    }



    /// <summary>
    /// Extrai o primeiro número inteiro encontrado numa string qualquer.
    /// </summary>
    private long ExtractFirstNumber(string text)
    {
        var m = Regex.Match(text, @"(\d+)", RegexOptions.IgnoreCase);
        return m.Success ? long.Parse(m.Groups[1].Value) : 0L;
    }


