    private void ParseFormResult(AnalyzeResult result)
    {
        // Dicionário temporário para armazenar os dados extraídos antes de atribuir ao objeto insight.
        var extractedData = new Dictionary<string, long>();

        // Normaliza o texto removendo pontos e vírgulas que são usados como separadores de milhar.
        // O Azure Form Recognizer já pode fornecer o conteúdo da linha sem esses caracteres,
        // mas aplicamos a normalização para garantir consistência, especialmente para regex.
        Func<string, string> normalizeTextForParsing = (text) =>
        {
            if (string.IsNullOrEmpty(text)) return string.Empty;
