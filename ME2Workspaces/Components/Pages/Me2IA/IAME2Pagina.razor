@page "/ia"

<MudContainer Class="pa-6">
    <MudPaper Elevation="3"
              Class="pa-6 mx-auto"
              Style="width:100%; max-width:1200px; border-radius:16px;
                     background:rgba(255,255,255,0.9); backdrop-filter:blur(8px);">

        <MudStack Spacing="3">
            <MudText Typo="Typo.h4" Align="Align.Center">
                ME2 IA
            </MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary">
                Pergunte qualquer coisa e receba uma resposta inteligente
            </MudText>

            <MudTextField @bind-Value="pergunta"
                          Placeholder="Digite sua pergunta..."
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Send"
                          OnAdornmentClick="BuscarPergunta" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="BuscarPergunta"
                       StartIcon="@Icons.Material.Filled.RocketLaunch">
                Enviar
            </MudButton>

            @if (isLoading)
            {
                <MudProgressLinear Indeterminate="true"
                                   Color="Color.Primary"
                                   Class="mt-2" />
            }

            @if (!string.IsNullOrEmpty(respostaIA))
            {
                <MudCard Class="mt-4"
                         Style="width:100%;"
                         Elevation="1">
                    <MudCardContent>
                        <MudText Typo="Typo.body1"
                                 Style="white-space:pre-wrap; font-size:1.1rem; line-height:1.6;">
                            @respostaIA
                        </MudText>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string pergunta = "";
    private string respostaIA;
    private bool isLoading;

    private async Task BuscarPergunta()
    {
        if (string.IsNullOrWhiteSpace(pergunta))
            return;

        isLoading = true;
        respostaIA = null;
        StateHasChanged();
       respostaIA = await ME2IAService.PerguntarIA(pergunta);

        isLoading = false;
    }
}
